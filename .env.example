# 🔐 VARIABLES DE ENTORNO - PLANTILLA PARA RENDER
# Copia estos valores a Render → Settings → Environment Variables

# ==================== SEGURIDAD ====================
# Clave secreta para JWT - GENERA UNA NUEVA
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ejemplo generado: Z7_K9x2nPq5mL8wT4j6vH3yB1cF0a9X2Y5
SECRET_KEY=REEMPLAZA_CON_TU_CLAVE_SECRETA

# ==================== CORS ====================
# URLs permitidas (IMPORTANTE para Render)
# Para desarrollo local: http://localhost:3000,http://localhost:8000
# Para producción: https://valeria-api.onrender.com
CORS_ORIGINS=https://valeria-api.onrender.com

# ==================== AMBIENTE ====================
# development | staging | production
ENVIRONMENT=production
