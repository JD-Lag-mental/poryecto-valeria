# Archivo de configuración de ejemplo
# Copia esto a .env y ajusta según tu entorno

# ==================== AMBIENTE ====================
ENVIRONMENT=development  # development | staging | production

# ==================== SEGURIDAD ====================
# CORS - Orígenes permitidos (separados por comas)
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Rate Limiting
RATE_LIMIT_REQUESTS=100          # Máximo requests
RATE_LIMIT_WINDOW=60             # Ventana en segundos (1 minuto)

# ==================== LOGGING ====================
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ==================== SERVIDOR ====================
HOST=127.0.0.1
PORT=8000
WORKERS=4

# ==================== SSL/TLS ====================
# SSL_KEYFILE=/path/to/key.pem
# SSL_CERTFILE=/path/to/cert.pem

# ==================== NOTAS ====================
# - En producción usar HTTPS obligatorio
# - Cambiar ALLOWED_ORIGINS a https://tudominio.com
# - Aumentar RATE_LIMIT_REQUESTS si necesario
# - NUNCA compartir este archivo con credenciales reales
